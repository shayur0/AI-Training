# From notion.so/my-integrations -> Project Agent -> Secrets tab
# Real value goes in integrations/.env, which is gitignored. Never commit the real value.
NOTION_API_KEY=

# The 32-character database ID from the board's URL, before the `?v=`
# (notion.so/workspace/<THIS PART>?v=...)
NOTION_GOALS_DB_ID=

# From api.slack.com/apps -> Project Agent -> OAuth & Permissions
SLACK_BOT_TOKEN=

# From api.slack.com/apps -> Project Agent -> Basic Information -> App Credentials
# Not used by slack.mjs yet -- needed in video 6 for the inbound webhook.
SLACK_SIGNING_SECRET=

# From Slack: right-click the channel -> View channel details -> bottom of the panel
SLACK_CHANNEL_ID=

# From github.com/settings/personal-access-tokens -> fine-grained token
# scoped to shayur0/AI-Training only, Contents: Read and write
GITHUB_TOKEN=

# Repo Settings -> Webhooks -> Add webhook -> Secret. Must match exactly
# what's entered in GitHub's webhook config. Not used until video 6.
GITHUB_WEBHOOK_SECRET=
